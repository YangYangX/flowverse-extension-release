{
  "schemaVersion": "1.0.0",
  "kind": "flowverse-agile-delivery-worldview-instance",
  "ontologyRef": "flowverse-core-ontology",
  "agileDeliveryOntologyRef": "agile-delivery-ontology",
  "world": {
    "id": "smart-factory-agile-delivery",
    "name": "Smart Factory Platform Delivery",
    "description": "Synthetic Jira-style portfolio for delivering, scaling, and governing the in-house smart-factory operations platform.",
    "ownerTeam": "Factory Digital Product Management",
    "defaultEnvironment": "synthetic-jira"
  },
  "domains": [
    {
      "id": "delivery-scopes",
      "name": "Delivery Scopes",
      "domainConceptRef": "delivery-scope",
      "description": "Programme and capability epics for the smart-factory platform."
    },
    {
      "id": "work-items",
      "name": "Work Items",
      "domainConceptRef": "work-item",
      "description": "Stories, tasks, spikes, and bugs executed by factory platform teams."
    },
    {
      "id": "delivery-controls",
      "name": "Delivery Controls",
      "domainConceptRef": "delivery-risk",
      "description": "Dependencies, blockers, validation evidence, defects, and readiness decisions."
    }
  ],
  "views": [
    {
      "id": "factory-delivery-hierarchy",
      "name": "Factory delivery hierarchy",
      "description": "Organization-chart projection driven by immediate parent-child relationships, with delivery dependencies retained as semantic edges.",
      "domainConceptRef": "delivery-view",
      "default": true,
      "entityConceptRefs": [
        "delivery-scope",
        "work-item"
      ],
      "relationshipConceptRefs": [
        "work-item-hierarchy",
        "work-link"
      ],
      "layout": {
        "kind": "organization-chart",
        "direction": "DOWN",
        "structuralRelationshipConceptRef": "work-item-hierarchy"
      }
    }
  ],
  "assessmentProfiles": [
    {
      "id": "delivery-readiness",
      "name": "Delivery readiness",
      "description": "Evidence-based readiness of a work item for shared understanding, planning, implementation, and completion.",
      "domainConceptRef": "delivery-metric",
      "default": true,
      "aggregation": "weighted-mean",
      "recommendationLimit": 5,
      "factors": [
        {
          "id": "purpose-context",
          "name": "Purpose and context",
          "description": "Clarity of the intended outcome, operational context, and reason the work is needed.",
          "weight": 20
        },
        {
          "id": "scope-requirements",
          "name": "Scope and requirements",
          "description": "Clarity, completeness, and testability of scope and requirements.",
          "weight": 20
        },
        {
          "id": "acceptance-completion",
          "name": "Acceptance and completion",
          "description": "Evidence that acceptance criteria and completion conditions are explicit and verifiable.",
          "weight": 20
        },
        {
          "id": "ownership-planning",
          "name": "Ownership and planning",
          "description": "Sufficiency of ownership, responsibility, iteration, priority, and delivery planning.",
          "weight": 20
        },
        {
          "id": "dependencies-risks",
          "name": "Dependencies and risks",
          "description": "Visibility and resolution of dependencies, blockers, risks, assumptions, and open decisions.",
          "weight": 20
        }
      ],
      "ratingBands": [
        {
          "id": "ready",
          "name": "Ready",
          "minimumScore": 85
        },
        {
          "id": "mostly-ready",
          "name": "Mostly ready",
          "minimumScore": 70
        },
        {
          "id": "needs-refinement",
          "name": "Needs refinement",
          "minimumScore": 50
        },
        {
          "id": "at-risk",
          "name": "At risk",
          "minimumScore": 0
        }
      ]
    }
  ],
  "deliveryVocabulary": {
    "sourceVocabularyRef": "agile-delivery-starter-vocabulary",
    "workItemTypes": [
      {
        "id": "epic",
        "name": "Epic",
        "hierarchyLevel": "epic",
        "isSubtask": false,
        "domainConceptRef": "delivery-scope"
      },
      {
        "id": "story",
        "name": "Story",
        "hierarchyLevel": "standard",
        "isSubtask": false,
        "domainConceptRef": "work-item"
      },
      {
        "id": "task",
        "name": "Task",
        "hierarchyLevel": "standard",
        "isSubtask": false,
        "domainConceptRef": "work-item"
      },
      {
        "id": "spike",
        "name": "Spike",
        "hierarchyLevel": "standard",
        "isSubtask": false,
        "domainConceptRef": "work-item"
      },
      {
        "id": "bug",
        "name": "Bug",
        "hierarchyLevel": "standard",
        "isSubtask": false,
        "domainConceptRef": "work-item"
      }
    ],
    "workflowStates": [
      {
        "id": "to-do",
        "name": "To Do",
        "statusCategory": "new",
        "domainConceptRef": "workflow-state"
      },
      {
        "id": "in-progress",
        "name": "In Progress",
        "statusCategory": "indeterminate",
        "domainConceptRef": "workflow-state"
      },
      {
        "id": "blocked-on-hold",
        "name": "Blocked / On Hold",
        "statusCategory": "indeterminate",
        "domainConceptRef": "workflow-state"
      },
      {
        "id": "done",
        "name": "Done",
        "statusCategory": "done",
        "domainConceptRef": "workflow-state"
      }
    ],
    "workflowTransitions": [
      {
        "id": "start",
        "name": "Start work",
        "from": "to-do",
        "to": "in-progress",
        "domainConceptRef": "workflow-transition"
      },
      {
        "id": "block",
        "name": "Block",
        "from": "in-progress",
        "to": "blocked-on-hold",
        "domainConceptRef": "workflow-transition"
      },
      {
        "id": "unblock",
        "name": "Unblock",
        "from": "blocked-on-hold",
        "to": "in-progress",
        "domainConceptRef": "workflow-transition"
      },
      {
        "id": "complete",
        "name": "Complete",
        "from": "in-progress",
        "to": "done",
        "domainConceptRef": "workflow-transition"
      }
    ],
    "linkTypes": [
      {
        "id": "parent-child",
        "name": "Parent / child",
        "outward": "contains",
        "inward": "is child of",
        "structural": true,
        "gatesFlow": false,
        "domainConceptRef": "work-item-hierarchy"
      },
      {
        "id": "blocks",
        "name": "Blocks",
        "outward": "blocks",
        "inward": "is blocked by",
        "gatesFlow": true,
        "domainConceptRef": "work-link"
      },
      {
        "id": "dependency",
        "name": "Dependency",
        "outward": "depends on",
        "inward": "is depended on by",
        "gatesFlow": true,
        "domainConceptRef": "work-link"
      },
      {
        "id": "implements",
        "name": "Implements",
        "outward": "implements",
        "inward": "is implemented by",
        "gatesFlow": false,
        "domainConceptRef": "work-link"
      },
      {
        "id": "validation",
        "name": "Validation",
        "outward": "is validated by",
        "inward": "validates",
        "gatesFlow": false,
        "domainConceptRef": "work-link"
      },
      {
        "id": "relates",
        "name": "Relates",
        "outward": "relates to",
        "inward": "relates to",
        "gatesFlow": false,
        "domainConceptRef": "work-link"
      },
      {
        "id": "defect",
        "name": "Defect",
        "outward": "has defect",
        "inward": "is defect for",
        "gatesFlow": false,
        "domainConceptRef": "work-link"
      }
    ],
